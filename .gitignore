# Lokale Werkzeuge und Geheimnisse: Godot, Exportvorlagen, Signaturschlüssel samt Passwort – nie veröffentlichen
.tools/
game/.godot/
builds/*
!builds/README.md
*.tmp

# Fremdmaterial: urheberrechtlich geschützt, nur lokale Höranalyse/Stilvorlage – nie veröffentlichen, nie ins Spiel übernehmen
audio/referenz/

# Gradle-Export: Vorlage und eigener Code (Java-Helfer, Manifest, gradle.properties) versionieren, Erzeugtes nicht (wie Draw2Race)
game/android/build/build/
game/android/build/.gradle/
game/android/build/src/main/assets/
game/android/build/src/instrumented/assets/
game/android/build/assetPackInstallTime/src/main/assets/
game/android/build/local.properties
game/android/build/libs/
# vom Export je Bauart erzeugt (Manifest mit Berechtigungen aus dem Exportprofil, Symbole, Namen)
game/android/build/src/debug/
game/android/build/src/release/

# Browser-Client als Archiv: erzeugt tools/build.ps1 (-Target Web, auch vor Test/Windows/Android) aus webclient/
game/assets/web.zip

# Bildschirmfotos echter Handys aus den Gerätetests: zeigen Gerätenamen und Statusleisten – nur lokal, die Berichte selbst sind im Repo
docs/geraetetest/**/*.jpg
docs/geraetetest/**/*.png

# KI-Ton-Kandidaten (groß, nur zum Auswählen): Rohfassungen, Spektrogramme, Kandidaten – im Repo bleiben README, Favoriten und Skripte
audio/sfx_ki/roh/
audio/sfx_ki/spektrogramme/
audio/sfx_ki/*.wav
audio/sfx_ki/*.ogg
audio/sfx_ki/*.m4a
tools/__pycache__/

# Recherche-Originale mit Quellen-Links, die den Namen des Originalspiels enthalten (AGENTS.md 2) – nur lokal
docs/recherche/_lokal/
