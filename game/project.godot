; Mau-Mau Flip – Godot 4.6.1. Diese Datei gehört Modul C (docs/BETA1_PLAN.md); andere Module melden Bedarf im Bericht.
; Version: config/version (X.Y.Z, nur Ziffern) – tools/build.ps1 trägt sie ins Android-Exportprofil ein (version/name, version/code).
config_version=5

[application]

config/name="Mau-Mau Flip"
config/description="Kartenspiel mit doppelseitigen Karten (Tag- und Nachtseite) für 2–10 Spieler."
config/version="1.2.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.051, 0.125, 1)
config/icon="res://assets/ui/icon_512.png"
boot_splash/image="res://assets/ui/splash.png"

[autoload]

App="*res://scripts/app/app.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[audio]

driver/enable_input=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.051, 0.125, 1)
