msgid "Keine neuere Version (eine ältere wird nie installiert)"
msgstr "Not a newer version (an older one is never installed)"

msgid "Versionsangabe passt nicht zur Datei"
msgstr "Version info doesn't match the file"

msgid "Signatur passt nicht – die Datei ist nicht signiert"
msgstr "Signature doesn't match – the file isn't signed"

msgid "Signatur passt nicht – die Datei stammt nicht vom Mau-Mau-Flip-Projekt oder wurde verändert"
msgstr "Signature doesn't match – the file isn't from the Mau-Mau Flip project or was modified"

msgid "Prüfung fehlgeschlagen"
msgstr "Check failed"

msgid "Installation nicht möglich"
msgstr "Installation not possible"

msgid "Teilen nicht möglich"
msgstr "Sharing not possible"

msgid "Bindung fehlgeschlagen"
msgstr "Binding failed"

msgid "Android hat die Bindung abgelehnt."
