msgid "alte Kopie nicht löschbar"
msgstr "Couldn't delete old copy"

msgid "Umbenennen fehlgeschlagen"
msgstr "Rename failed"

msgid "Bereite die Datei vor …"
msgstr "Preparing the file …"

msgid "Teilen-Menü geöffnet – wähle Quick Share, Bluetooth oder eine andere App."
msgstr "Share menu opened – choose Quick Share, Bluetooth or another app."

msgid "Datei bereit."
msgstr "File ready."

msgid "Vorbereitung fehlgeschlagen: %s"
msgstr "Preparation failed: %s"

msgid "Mau-Mau Flip %s (Android-App)"
msgstr "Mau-Mau Flip %s (Android app)"

msgid "Mau-Mau Flip teilen"
msgstr "Share Mau-Mau Flip"

msgid "Dein erster Partiesieg!"
msgstr "Your first game win!"

msgid "Dein erster Rundensieg!"
msgstr "Your first round win!"

msgid "Dein %d. Partiesieg!"
msgstr "Game win number %d!"

msgid "Dein %d. Rundensieg!"
msgstr "Round win number %d!"

msgid "Gastgeber antwortet nicht (%d s)."
msgstr "The host isn't answering (%d s)."

msgid "Anmeldung nicht beantwortet."
msgstr "Sign-in wasn't answered."

msgid "Gastgeber %s:%d nicht erreichbar."
msgstr "Can't reach host %s:%d."

msgid "Diese Verbindung wurde durch eine neuere ersetzt."
msgstr "This connection was replaced by a newer one."

msgid "Verbindung getrennt (%d)."
msgstr "Connection lost (%d)."

